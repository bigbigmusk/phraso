    {
      "engine_id": "ko_engine_01_want",
      "title_zh": "表达想做某事",
      "structure_hint": "-고 싶어요",
      "summary_zh": "动词后接 -고 싶어요，主语常由语境省略。",
      "status": "available",
      "free": true,
      "lessons": [
        {
          "lesson_id": "ko_want_01",
          "title_zh": "我想说韩语",
          "duration_min": 9,
          "objective_zh": "理解 -고 싶어요 结构和助词 -로，并迁移到新的时间场景。",
          "exercises": [
            {
              "exercise_id": "ko_want_01_warm",
              "type": "warm_start",
              "explanation_zh": "韩语的句子按自己的逻辑生长：信息可以省略，助词标记角色，语尾表达语气。这节课先搭第一个韩语结构。",
              "hint_zh": "词块按意义单位拆分，不按单个字拆分。"
            },
            {
              "exercise_id": "ko_want_01_understand",
              "type": "understand",
              "explanation_zh": "「想做某事」在韩语里是动词后接 -고 싶어요。「说」是 말하다，去掉 -다 接上后就是 말하고 싶어요（想说）。注意：不需要说「我」——语境清楚时主语直接省略。",
              "canonical": "말하고 싶어요.",
              "romanized": "malhago sipeoyo",
              "hint_zh": "싶어요 的 어요 是客气语尾，日常对话默认使用。"
            },
            {
              "exercise_id": "ko_want_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我想说韩语。",
              "canonical": "한국어로 말하고 싶어요.",
              "romanized": "hangugeoro malhago sipeoyo",
              "focus_tags": ["want_desiderative", "particle_ro"],
              "hint_zh": "「用韩语」是 한국어 + 助词 로（用/以），然后接「想说」。"
            },
            {
              "exercise_id": "ko_want_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我想说韩语。",
              "canonical": "한국어로 말하고 싶어요.",
              "romanized": "hangugeoro malhago sipeoyo",
              "blocks": ["한국어로", "말하고 싶어요"],
              "distractors": ["한국어를", "말해요"],
              "focus_tags": ["want_desiderative", "particle_ro"],
              "hint_zh": "助词 로 表示「用（某种语言）」，注意和宾语助词 를 区分。"
            },
            {
              "exercise_id": "ko_want_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我想学习。",
              "canonical": "배우고 싶어요.",
              "romanized": "baeugo sipeoyo",
              "blocks": ["배우고", "싶어요"],
              "distractors": ["말하고"],
              "focus_tags": ["want_desiderative"],
              "hint_zh": "「学」是 배우다 → 배우고 + 싶어요。"
            },
            {
              "exercise_id": "ko_want_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我想说韩语。",
              "canonical": "한국어로 말하고 싶어요.",
              "romanized": "hangugeoro malhago sipeoyo",
              "focus_tags": ["want_desiderative", "pronunciation"]
            },
            {
              "exercise_id": "ko_want_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：我现在想说。",
              "canonical": "지금 말하고 싶어요.",
              "romanized": "jigeum malhago sipeoyo",
              "blocks": ["지금", "말하고 싶어요"],
              "distractors": ["한국어로"],
              "focus_tags": ["want_desiderative", "time_word"],
              "hint_zh": "只改变一个变量：把「用韩语」换成时间词 지금（现在），放在句首。"
            }
          ]
        }
      ]
    },
