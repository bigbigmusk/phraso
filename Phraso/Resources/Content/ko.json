              "hint_zh": "저는 + 名字 + 예요。"
            },
            {
              "exercise_id": "ko_intro_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我是民浩。",
              "canonical": "저는 민호예요.",
              "romanized": "jeoneun Minho-yeyo",
              "blocks": ["저는", "민호예요"],
              "distractors": ["민호가"],
              "focus_tags": ["self_intro"]
            },
            {
              "exercise_id": "ko_intro_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我来自中国。",
              "canonical": "중국에서 왔어요.",
              "romanized": "junggugeseo wasseoyo",
              "blocks": ["중국에서", "왔어요"],
              "distractors": ["중국을"],
              "focus_tags": ["origin", "particle_eseo"],
              "hint_zh": "에서 表示「从（某地）」；主语「我」再次省略。"
            },
            {
              "exercise_id": "ko_intro_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我是安娜。",
              "canonical": "저는 안나예요.",
              "romanized": "jeoneun Anna-yeyo",
              "focus_tags": ["self_intro", "pronunciation"]
            },
            {
              "exercise_id": "ko_intro_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：我是学生。",
              "canonical": "저는 학생이에요.",
              "romanized": "jeoneun haksaeng-ieyo",
              "blocks": ["저는", "학생이에요"],
              "distractors": ["안나예요"],
              "focus_tags": ["self_intro", "copula_variant"],
              "hint_zh": "只改变身份：학생（学生）以辅音结尾，所以「是」用 이에요 而不是 예요。"
            }
          ]
        }
      ]
    },
