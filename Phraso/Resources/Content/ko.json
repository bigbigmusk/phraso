              "exercise_id": "ko_like_01_warm",
              "type": "warm_start",
              "explanation_zh": "聊喜好是韩语对话最自然的起点。这节课认识宾语助词 를/을。"
            },
            {
              "exercise_id": "ko_like_01_understand",
              "type": "understand",
              "explanation_zh": "「我喜欢咖啡」：커피（咖啡）+ 宾语助词 를 + 좋아해요（喜欢）。助词告诉你「咖啡」是被喜欢的对象。",
              "canonical": "커피를 좋아해요.",
              "romanized": "keopireul joahaeyo",
              "hint_zh": "커피 以元音结尾用 를；辅音结尾的词用 을。"
            },
            {
              "exercise_id": "ko_like_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我喜欢咖啡。",
              "canonical": "커피를 좋아해요.",
              "romanized": "keopireul joahaeyo",
              "focus_tags": ["like", "object_particle"],
              "hint_zh": "커피를 + 좋아해요。「我」省略。"
            },
            {
              "exercise_id": "ko_like_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我喜欢咖啡。",
              "canonical": "커피를 좋아해요.",
              "romanized": "keopireul joahaeyo",
              "blocks": ["커피를", "좋아해요"],
              "distractors": ["커피가", "있어요"],
              "focus_tags": ["like"]
            },
            {
              "exercise_id": "ko_like_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我喜欢茶。",
              "canonical": "차를 좋아해요.",
              "romanized": "chareul joahaeyo",
              "blocks": ["차를", "좋아해요"],
              "distractors": ["커피를"],
              "focus_tags": ["like"]
            },
            {
              "exercise_id": "ko_like_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我喜欢咖啡。",
              "canonical": "커피를 좋아해요.",
              "romanized": "keopireul joahaeyo",
              "focus_tags": ["like", "pronunciation"]
            },
            {
              "exercise_id": "ko_like_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：我喜欢音乐。",
              "canonical": "음악을 좋아해요.",
              "romanized": "eumageul joahaeyo",
              "blocks": ["음악을", "좋아해요"],
              "distractors": ["음악를"],
              "focus_tags": ["like", "particle_variant"],
              "hint_zh": "只改变对象：음악（音乐）以辅音结尾，助词要用 을。"
            }
          ]
        }
      ]
    },
