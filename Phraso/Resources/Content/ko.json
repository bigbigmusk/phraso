            },
            {
              "exercise_id": "ko_intro_01_understand",
              "type": "understand",
              "explanation_zh": "「我是安娜」：저（我）+ 主题助词 는 + 名字 + 예요（是）。예요 放在句尾，是客气的说法。",
              "canonical": "저는 안나예요.",
              "romanized": "jeoneun Anna-yeyo",
              "hint_zh": "는 标记「话题」：这句话是关于我的。"
            },
            {
              "exercise_id": "ko_intro_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我是安娜。",
              "canonical": "저는 안나예요.",
              "romanized": "jeoneun Anna-yeyo",
