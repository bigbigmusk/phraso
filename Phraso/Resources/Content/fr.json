    {
      "engine_id": "fr_engine_01_want",
      "title_zh": "表达想做某事",
      "structure_hint": "Je veux + 动词原形",
      "summary_zh": "用 Je veux 加动词原形，说出你想做的任何事。",
      "status": "available",
      "free": true,
      "lessons": [
        {
          "lesson_id": "fr_want_01",
          "title_zh": "我想说法语",
          "duration_min": 8,
          "objective_zh": "学会用 Je veux + 动词原形 表达意愿，并把它迁移到新的时间场景。",
          "exercises": [
            {
              "exercise_id": "fr_want_01_warm",
              "type": "warm_start",
              "explanation_zh": "这节课你会学到法语里最有用的结构之一：说出「我想做某事」。先思考，再揭晓——不用着急。",
              "hint_zh": "整节课只有一个新零件，其他都会由你自己组装。"
            },
            {
              "exercise_id": "fr_want_01_understand",
              "type": "understand",
              "explanation_zh": "法语里「我想」是 Je veux。它后面直接加动词原形，不需要任何连接词。比如 parler 是「说话」，合起来就是「我想说」。",
              "canonical": "Je veux parler.",
              "hint_zh": "veux 的 x 不发音，听起来像「热·维」。发音只是提示，可懂度优先。"
            },
            {
              "exercise_id": "fr_want_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我想说法语。",
              "canonical": "Je veux parler français.",
              "acceptable_variants": ["Je veux parler le français."],
              "focus_tags": ["want_infinitive", "word_order"],
              "hint_zh": "结构：Je veux + 动词原形 + 语言名。「法语」是 français。"
            },
            {
              "exercise_id": "fr_want_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我想说法语。",
              "canonical": "Je veux parler français.",
              "blocks": ["Je", "veux", "parler", "français"],
              "distractors": ["veut", "parle"],
              "focus_tags": ["want_infinitive"]
            },
            {
              "exercise_id": "fr_want_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我想学习。",
              "canonical": "Je veux apprendre.",
              "blocks": ["Je", "veux", "apprendre"],
              "distractors": ["parler", "veut"],
              "focus_tags": ["want_infinitive"]
            },
            {
              "exercise_id": "fr_want_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我想说法语。",
              "canonical": "Je veux parler français.",
              "focus_tags": ["want_infinitive", "pronunciation"]
            },
            {
              "exercise_id": "fr_want_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：我现在想说。",
              "canonical": "Je veux parler maintenant.",
              "blocks": ["Je", "veux", "parler", "maintenant"],
              "distractors": ["français"],
              "focus_tags": ["want_infinitive", "time_word"],
              "hint_zh": "只改变一个变量：把「法语」换成「现在」maintenant，放在句末。"
            }
          ]
        }
      ]
    },
