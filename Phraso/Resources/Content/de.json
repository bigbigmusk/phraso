      "structure_hint": "Ich heiße… / Ich komme aus…",
      "summary_zh": "介绍名字和来自哪里。",
      "status": "available",
      "free": false,
      "lessons": [
        {
          "lesson_id": "de_intro_01",
          "title_zh": "我叫……",
          "duration_min": 8,
          "objective_zh": "学会介绍名字与来源地，并迁移到介绍别人。",
          "exercises": [
            {
              "exercise_id": "de_intro_01_warm",
              "type": "warm_start",
              "explanation_zh": "你已经搭过德语句框了。这节课的结构更简单：动词稳稳站在第二位。"
            },
            {
              "exercise_id": "de_intro_01_understand",
              "type": "understand",
              "explanation_zh": "介绍名字用 Ich heiße（我名叫），后面直接加名字。动词 heiße 在第二位，这是德语陈述句的铁律。",
              "canonical": "Ich heiße Anna.",
              "hint_zh": "ß 读作清晰的 s 音。"
            },
            {
              "exercise_id": "de_intro_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我叫安娜。",
              "canonical": "Ich heiße Anna.",
              "focus_tags": ["self_intro", "verb_second"],
              "hint_zh": "Ich + heiße + 名字。"
            },
            {
              "exercise_id": "de_intro_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我叫保罗。",
              "canonical": "Ich heiße Paul.",
              "blocks": ["Ich", "heiße", "Paul"],
              "distractors": ["will", "bin"],
              "focus_tags": ["self_intro"]
            },
            {
              "exercise_id": "de_intro_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我来自中国。",
              "canonical": "Ich komme aus China.",
              "blocks": ["Ich", "komme", "aus", "China"],
              "distractors": ["heiße"],
              "focus_tags": ["origin"],
              "hint_zh": "「来自」是 komme aus，两个词块都不能少。"
            },
            {
              "exercise_id": "de_intro_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我叫安娜。",
              "canonical": "Ich heiße Anna.",
              "focus_tags": ["self_intro", "pronunciation"]
            },
            {
              "exercise_id": "de_intro_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：他叫保罗。",
              "canonical": "Er heißt Paul.",
              "blocks": ["Er", "heißt", "Paul"],
              "distractors": ["Ich", "heiße"],
              "focus_tags": ["self_intro", "third_person"],
              "hint_zh": "只改变人物：Ich heiße → Er heißt，动词词尾跟着人称变化。"
            }
          ]
        }
      ]
    },
