  "engines": [
    {
      "engine_id": "de_engine_01_want",
      "title_zh": "表达想做某事",
      "structure_hint": "Ich will … + 动词在句尾",
      "summary_zh": "德语的句框结构：情态动词在第二位，主要动词去句尾。",
      "status": "available",
      "free": true,
      "lessons": [
        {
          "lesson_id": "de_want_01",
          "title_zh": "我想说德语",
          "duration_min": 9,
          "objective_zh": "理解德语句框：wollen 在第二位，主要动词在句尾；并迁移到加入时间词。",
          "exercises": [
            {
              "exercise_id": "de_want_01_warm",
              "type": "warm_start",
              "explanation_zh": "德语最重要的不是单词，而是句子的「框架」。这节课你会亲手搭一次这个框架。",
              "hint_zh": "德语按自己的语序逻辑教学，不套用其他语言的顺序。"
            },
            {
              "exercise_id": "de_want_01_understand",
              "type": "understand",
              "explanation_zh": "德语里「我想」是 Ich will。关键规则：will 占据第二位，而真正的动作动词（比如 sprechen「说」）要放到句子的最后，形成一个「句框」。",
              "canonical": "Ich will sprechen.",
              "hint_zh": "记住画面：will 和 sprechen 像两扇门，把句子的其他部分夹在中间。"
            },
            {
              "exercise_id": "de_want_01_recall",
              "type": "guided_recall",
              "prompt_zh": "我想说德语。",
              "canonical": "Ich will Deutsch sprechen.",
              "focus_tags": ["want_modal", "verb_final"],
              "hint_zh": "Ich will + 宾语 + 动词原形在句尾。「德语」Deutsch 放在中间。"
            },
            {
              "exercise_id": "de_want_01_assemble1",
              "type": "assemble",
              "prompt_zh": "我想说德语。",
              "canonical": "Ich will Deutsch sprechen.",
              "blocks": ["Ich", "will", "Deutsch", "sprechen"],
              "distractors": ["wollen", "spreche"],
              "focus_tags": ["want_modal", "verb_final"]
            },
            {
              "exercise_id": "de_want_01_assemble2",
              "type": "assemble",
              "prompt_zh": "我想学习。",
              "canonical": "Ich will lernen.",
              "blocks": ["Ich", "will", "lernen"],
              "distractors": ["sprechen", "wollen"],
              "focus_tags": ["want_modal"]
            },
            {
              "exercise_id": "de_want_01_speak",
              "type": "speak",
              "prompt_zh": "开口说：我想说德语。",
              "canonical": "Ich will Deutsch sprechen.",
              "focus_tags": ["want_modal", "pronunciation"]
            },
            {
              "exercise_id": "de_want_01_transfer",
              "type": "transfer",
              "prompt_zh": "迁移一下：我今天想说德语。",
              "canonical": "Ich will heute Deutsch sprechen.",
              "blocks": ["Ich", "will", "heute", "Deutsch", "sprechen"],
              "distractors": ["morgen"],
              "focus_tags": ["want_modal", "verb_final", "time_word"],
              "hint_zh": "只加一个变量：时间词 heute（今天）放进句框中间，sprechen 仍然守在句尾。"
            }
          ]
        }
      ]
    },
    {
